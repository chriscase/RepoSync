FROM node:22-bookworm-slim AS node-runtime
FROM rust:1.98.1-bookworm AS build
ENV CARGO_BUILD_JOBS=2
ENV CARGO_TARGET_DIR=/src/target
# Bound cache growth across five isolated source builds; no incremental objects
# or debug symbols. Assertions and unoptimized test behavior remain enabled.
ENV CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
RUN apt-get update && apt-get install -y --no-install-recommends \
    git subversion pkg-config libssl-dev python3 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY Cargo.toml ./
COPY crates ./crates
COPY web-ui ./web-ui
COPY docs/reliability/legacy-evidence-vocabulary.json ./docs/reliability/legacy-evidence-vocabulary.json
COPY docs/reliability/fixtures/Cargo.lock ./Cargo.lock
COPY scripts/reliability-prep.py /usr/local/bin/reliability-prep
ARG RELIABILITY_INCLUDE_OLD=1
ARG RELIABILITY_TARGET_CACHE
ARG RELIABILITY_OLD_TARGET_CACHE
# The script binds these IDs to exact source/tree, lock, recipe and build mode.
# The toolchain tag is explicit; Cargo also fingerprints the actual compiler.
RUN --mount=type=cache,id=rust-1.98.1-bookworm-${RELIABILITY_TARGET_CACHE},target=/src/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    test -n "$RELIABILITY_TARGET_CACHE" && \
    if [ "$RELIABILITY_INCLUDE_OLD" = 1 ]; then \
      cargo build --workspace --bins --locked --features reposync-core/reliability-fixture,reposync-web/reliability-fixture --message-format=json > /tmp/cargo-applications.jsonl && \
      cargo test --workspace --no-run --locked --features reposync-core/reliability-fixture,reposync-web/reliability-fixture --message-format=json > /tmp/cargo-preparation.jsonl; \
    else \
      cargo build --workspace --bins --locked --message-format=json > /tmp/cargo-applications.jsonl && \
      cargo test --workspace --no-run --locked --message-format=json > /tmp/cargo-preparation.jsonl; \
    fi && \
    python3 /usr/local/bin/reliability-prep /tmp/cargo-preparation.jsonl /opt/reliability-tests \
      --applications /tmp/cargo-applications.jsonl --fixtures /src/crates/core/tests/fixtures && \
    rustc --version > /opt/reliability-tests/build-toolchain.txt && \
    cargo --version >> /opt/reliability-tests/build-toolchain.txt && \
    sha256sum Cargo.lock >> /opt/reliability-tests/build-toolchain.txt
COPY legacy-old /old-src
RUN --mount=type=cache,id=rust-1.98.1-bookworm-old-${RELIABILITY_OLD_TARGET_CACHE},target=/src/target \
    --mount=type=cache,target=/usr/local/cargo/registry \
    test -n "$RELIABILITY_OLD_TARGET_CACHE" && mkdir -p /opt/reliability-old-tests && \
    if [ "$RELIABILITY_INCLUDE_OLD" = 1 ]; then \
      cd /old-src && cargo test -p reposync-web --test legacy_import_generator --no-run --locked --message-format=json \
        > /tmp/old-preparation.jsonl && \
      python3 /usr/local/bin/reliability-prep /tmp/old-preparation.jsonl /opt/reliability-old-tests && \
      sha256sum /opt/reliability-old-tests/legacy_import_generator-* > /opt/reliability-old-tests/generator.sha256 && \
      sha256sum crates/web/tests/legacy_import_generator.rs > /opt/reliability-old-tests/overlay.sha256 && \
      sha256sum Cargo.lock > /opt/reliability-old-tests/lock.sha256; \
    fi

FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    git git-lfs subversion openssl libssl3 libstdc++6 libatomic1 ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
RUN ln -s /usr/local/bin/node /usr/bin/nodejs && \
    mkdir -p /src/crates/web /src/crates/cli /src/crates/personal /src/crates/core/tests/fixtures /src/target/debug && \
    ln -s /opt/reliability-tests/reposync /src/target/debug/reposync && \
    ln -s /opt/reliability-tests/reposync-personal /src/target/debug/reposync-personal && \
    test -z "$(getent passwd 65532)" && test -z "$(getent group 65532)" && \
    printf 'fixture:x:65532:65532:Fixture:/fixture/home:/usr/sbin/nologin\n' >> /etc/passwd && \
    printf 'fixture:x:65532:\n' >> /etc/group && \
    test ! -L /etc/machine-id && printf '21300000000040008000000000000001\n' > /etc/machine-id
ENV PATH="/usr/local/bin:/usr/bin:/bin"
ENV REPOSYNC_NODE_BIN=/usr/bin/nodejs
# Synthetic identity is confined to this image; native boot/PID observations stay real.
# EMAIL is a fallback; explicit test user.name/user.email and author env win.
ENV EMAIL=fixture@example.invalid
# Web UI contract tests resolve web-ui via compile-time CARGO_MANIFEST_DIR (/src/crates/web).
COPY --from=build /src/web-ui /src/web-ui
COPY --from=build /opt/reliability-tests /opt/reliability-tests
COPY --from=build /src/crates/core/tests/fixtures/git_http_auth_server.py /src/crates/core/tests/fixtures/git_http_auth_server.py
COPY --from=build /src/crates/core/tests/fixtures/pair_refresh_http_server.py /src/crates/core/tests/fixtures/pair_refresh_http_server.py
RUN node --version >> /opt/reliability-tests/build-toolchain.txt && \
    sha256sum /usr/local/bin/node >> /opt/reliability-tests/build-toolchain.txt
COPY --from=build /opt/reliability-old-tests /opt/reliability-old-tests
COPY scripts/reliability-runtime.py /usr/local/bin/reliability-runtime
COPY scripts/reliability-copy-consumer.mjs /opt/reliability-copy-consumer.mjs
ENV REPOSYNC_COPY_CONSUMER=/opt/reliability-copy-consumer.mjs
COPY scripts/reliability-scoped-consumer.mjs /opt/reliability-scoped-consumer.mjs
ENV REPOSYNC_SCOPED_CONSUMER=/opt/reliability-scoped-consumer.mjs
COPY scripts/reliability_scan.py /usr/local/bin/reliability_scan.py
COPY scripts/reliability-inventory.py /usr/local/bin/reliability-inventory.py
COPY docs/reliability/legacy-evidence-vocabulary.json /usr/local/bin/legacy-evidence-vocabulary.json
COPY scripts/reliability-inventory-probes.py /usr/local/bin/reliability-inventory-probes.py
COPY docs/reliability/required-cases.json /opt/reliability/required-cases.json
USER 65532:65532
ENTRYPOINT ["python3", "/usr/local/bin/reliability-runtime"]
