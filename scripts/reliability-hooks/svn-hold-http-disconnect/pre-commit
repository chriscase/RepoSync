#!/bin/sh
# Subversion passes the repository path; the control files sit beside it.
root=$(dirname "$1")
printf ready > "$root/http-disconnect-ready"
attempt=0
while [ "$attempt" -lt 600 ]; do
    [ -f "$root/http-disconnect-release" ] && exit 0
    sleep 0.05
    attempt=$((attempt + 1))
done
exit 1
