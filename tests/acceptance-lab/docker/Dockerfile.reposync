# Acceptance-lab daemon image. Builds the real daemon and the shipped React
# bundle. It does not replace the repository's production Dockerfile.
# The default Rust tag matches Dockerfile.reliability. It does not show that
# the product Dockerfile (rust:1.83-bookworm) or its MSRV builds.
# Pins are build args so prepare can record the toolchain identity.

ARG DEBIAN_IMAGE=debian:bookworm-slim
ARG RUST_IMAGE=rust:1.98.1-bookworm
ARG NODE_IMAGE=node:22.14.0-bookworm-slim

FROM ${NODE_IMAGE} AS ui
WORKDIR /ui
COPY web-ui/package.json web-ui/package-lock.json ./
RUN npm ci
COPY web-ui/ ./
RUN npm run build
RUN test -f dist/index.html

FROM ${RUST_IMAGE} AS rust
ARG RUST_IMAGE=rust:1.98.1-bookworm
ARG RUST_REPO_DIGEST=unrecorded
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends \
      pkg-config libssl-dev cmake ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY Cargo.toml ./
COPY crates ./crates
# Two cargo jobs: the public Ubuntu runner is 4 CPUs / 16 GB. Measure before
# raising this. There is no root Cargo.lock. Cargo writes a lock for this
# build only. The launcher copies that lock and metadata out of the image.
# Nothing here updates a shared lock or the product manifests.
# Hosted run 38188277459 finished this release build, then
# `cargo metadata --locked --offline` failed while downloading
# android_system_properties 0.1.6. Metadata resolves every target, and the
# linux build had not fetched that crate. Metadata stays --locked and is not
# --offline, so it can fetch crates the build did not compile.
ENV CARGO_BUILD_JOBS=2
RUN cargo build --release --bin reposync-daemon --bin reposync \
    && test -s Cargo.lock \
    && cp Cargo.lock /tmp/Cargo.lock \
    && sha256sum Cargo.lock > /tmp/Cargo.lock.sha256 \
    && { printf 'rust_image=%s\n' "$RUST_IMAGE"; \
         rustc --version; \
         cargo --version; \
         printf 'rust_repo_digest=%s\n' "$RUST_REPO_DIGEST"; \
         printf 'metadata_host=%s\n' "$(rustc -vV | sed -n 's/^host: //p')"; } > /tmp/rustc-version.txt \
    && test -s /tmp/Cargo.lock \
    && test -s /tmp/Cargo.lock.sha256 \
    && test -s /tmp/rustc-version.txt \
    && test -x target/release/reposync-daemon \
    && test -x target/release/reposync
RUN host="$(rustc -vV | sed -n 's/^host: //p')" \
    && test -n "$host" \
    && cargo metadata --format-version 1 --locked --filter-platform "$host" > /tmp/cargo-metadata.json \
    && test -s /tmp/cargo-metadata.json

FROM ${DEBIAN_IMAGE} AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git libssl3 sqlite3 subversion util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --system --create-home --home-dir /var/lib/reposync --shell /usr/sbin/nologin reposync
COPY --from=rust /src/target/release/reposync-daemon /usr/local/bin/reposync-daemon
COPY --from=rust /src/target/release/reposync /usr/local/bin/reposync
COPY --from=ui /ui/dist /usr/local/bin/static
COPY --from=rust /tmp/Cargo.lock /usr/local/share/acceptance-lab/Cargo.lock
COPY --from=rust /tmp/Cargo.lock.sha256 /usr/local/share/acceptance-lab/Cargo.lock.sha256
COPY --from=rust /tmp/cargo-metadata.json /usr/local/share/acceptance-lab/cargo-metadata.json
COPY --from=rust /tmp/rustc-version.txt /usr/local/share/acceptance-lab/rustc-version.txt
# Main's root .dockerignore omits tests/. The launcher passes this directory
# as the labfiles build context so the entrypoint is still in the image.
COPY --from=labfiles reposync-entrypoint.sh /usr/local/bin/lab-entrypoint.sh
RUN chmod 755 /usr/local/bin/lab-entrypoint.sh /usr/local/bin/reposync-daemon /usr/local/bin/reposync \
    && test -f /usr/local/bin/static/index.html \
    && test -s /usr/local/share/acceptance-lab/Cargo.lock \
    && test -s /usr/local/share/acceptance-lab/Cargo.lock.sha256 \
    && test -s /usr/local/share/acceptance-lab/cargo-metadata.json \
    && test -s /usr/local/share/acceptance-lab/rustc-version.txt
USER root
WORKDIR /var/lib/reposync
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/lab-entrypoint.sh"]
