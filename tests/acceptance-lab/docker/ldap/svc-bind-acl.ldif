# osixia 02-security.ldif lets only cn=admin read other entries. Run
# 38192643639 bound uid=svc-bind and then returned noSuchObject for
# (uid=alice). The service account can search and read directory data.
# It cannot read userPassword. Root over ldapi keeps manage so later
# TLS configuration still applies. Clients still verify server certificates.
dn: olcDatabase={1}{{ LDAP_BACKEND }},cn=config
changetype: modify
delete: olcAccess
-
add: olcAccess
olcAccess: to * by dn.exact=gidNumber=0+uidNumber=0,cn=peercred,cn=external,cn=auth manage by * break
olcAccess: to attrs=userPassword,shadowLastChange by self write by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by anonymous auth by * none
olcAccess: to * by self read by dn.exact="cn=admin,{{ LDAP_BASE_DN }}" write by dn.exact="uid=svc-bind,ou=services,{{ LDAP_BASE_DN }}" read by * none
