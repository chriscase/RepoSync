# Acceptance-lab image tags. `acceptance-lab.sh prepare` records RepoDigests.
# Do not point these at :latest. Digests are run evidence, not a company registry.
DEBIAN_IMAGE=debian:bookworm-slim
RUST_IMAGE=rust:1.83.0-bookworm
NODE_IMAGE=node:22.14.0-bookworm-slim
GITEA_IMAGE=gitea/gitea:1.22.6
LDAP_IMAGE=osixia/openldap:1.5.0
PLAYWRIGHT_VERSION=1.55.1
# Product Dockerfile at this base uses rust:1.83-bookworm. The lab pins the
# patch tag so the daemon image and the engine job share one toolchain name.
RUST_TOOLCHAIN=1.83.0
NODE_MAJOR=22
