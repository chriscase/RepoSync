# Acceptance-lab image tags. `acceptance-lab.sh prepare` records RepoDigests.
# Do not point these at :latest. Digests are run evidence, not a company registry.
DEBIAN_IMAGE=debian:bookworm-slim
# Harness compiler. Same official tag as Dockerfile.reliability. The product
# Dockerfile stays rust:1.83-bookworm and is not built by this pin.
# Hosted run 38183172933 recorded cargo 1.83.0 failing on getrandom 0.4.3
# (edition2024). That result stays with the product toolchain owner.
RUST_IMAGE=rust:1.98.1-bookworm
NODE_IMAGE=node:22.14.0-bookworm-slim
GITEA_IMAGE=gitea/gitea:1.22.6
LDAP_IMAGE=osixia/openldap:1.5.0
PLAYWRIGHT_VERSION=1.55.1
# Lab image and the dispatched engine job only. This name does not change
# the product MSRV or the product Dockerfile.
RUST_TOOLCHAIN=1.98.1
NODE_MAJOR=22
